{
  "name": "asufc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsc --strict --target ES2022 --module commonjs --lib ES2022,DOM --skipLibCheck --outDir .test-build src/api.ts src/receipt-text.ts && node -e \"for (const name of ['api','receipt-text']) require('node:fs').renameSync('.test-build/'+name+'.js','.test-build/'+name+'.cjs')\" && node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
