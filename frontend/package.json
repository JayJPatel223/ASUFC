{
  "name": "asufc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsc --strict --target ES2022 --module commonjs --lib ES2022,DOM --skipLibCheck --outDir .test-build src/api.ts && node -e \"require('node:fs').renameSync('.test-build/api.js','.test-build/api.cjs')\" && node --test tests/*.test.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "8.3.8",
    "@playwright/test": "^1.51.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
